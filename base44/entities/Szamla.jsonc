{
  "name": "Szamla",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "title": "Foglalás azonosító"
    },
    "invoice_number": {
      "type": "string",
      "title": "Számlaszám"
    },
    "customer_name": {
      "type": "string",
      "title": "Ügyfél neve"
    },
    "email": {
      "type": "string",
      "title": "Ügyfél e-mail"
    },
    "phone": {
      "type": "string",
      "title": "Telefonszám"
    },
    "service": {
      "type": "string",
      "title": "Szolgáltatás"
    },
    "amount": {
      "type": "number",
      "title": "Bruttó összeg"
    },
    "net_amount": {
      "type": "number",
      "title": "Nettó összeg"
    },
    "vat_amount": {
      "type": "number",
      "title": "ÁFA összege"
    },
    "items": {
      "type": "array",
      "title": "Számlatételek",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "gross_unit_price": { "type": "number" },
          "vat_rate": { "type": "number" },
          "net_amount": { "type": "number" },
          "vat_amount": { "type": "number" },
          "gross_amount": { "type": "number" }
        }
      }
    },
    "pdf_uri": {
      "type": "string",
      "title": "Privát minta PDF azonosító"
    },
    "currency": {
      "type": "string",
      "title": "Pénznem",
      "default": "HUF"
    },
    "status": {
      "type": "string",
      "title": "Státusz",
      "enum": ["issued", "sent", "failed"],
      "default": "issued"
    },
    "pdf_url": {
      "type": "string",
      "title": "PDF URL"
    },
    "notes": {
      "type": "string",
      "title": "Megjegyzés"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "E-mail küldés ideje"
    },
    "last_email_error": {
      "type": "string",
      "title": "Utolsó e-mail küldési hiba"
    }
  },
  "required": [
    "booking_id",
    "invoice_number",
    "customer_name",
    "email",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
